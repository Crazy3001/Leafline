{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the overlay, workbench, settings, setup, build planner, training log and pinned panel windows",
  "windows": ["overlay", "workbench", "settings", "setup", "build", "training", "pin-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-set-size",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
