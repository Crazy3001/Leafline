{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the overlay, settings, setup, desk view (training log and build planner included) and pinned panel windows",
  "windows": ["overlay", "settings", "setup", "desk", "pin-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-set-size",
    "core:webview:allow-set-webview-zoom",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
