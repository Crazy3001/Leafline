{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the overlay, workbench, settings and pinned panel windows",
  "windows": ["overlay", "workbench", "settings", "pin-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-set-size",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
